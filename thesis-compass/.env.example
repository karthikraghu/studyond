# Environment Configuration for Thesis Compass Backend
# Copy this file to .env or .env.local and fill in your actual API keys

# Anthropic API Key (required for AI-powered CV extraction)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinecone Configuration (required for semantic matching)
# Get your key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=studyond-brain
